---
import "@fontsource-variable/manrope";
import "../styles/tokens.css";
import "../styles/typography.css";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import ChatWidget from "../components/ChatWidget.astro";
import { business, isPlaceholderBuild, isFixtureBuild } from "../data/business";
import { counties } from "../data/dfw-coverage";
import { buildWebSite, buildOrganization, buildBreadcrumbs } from "../lib/jsonld.mjs";

interface Props {
  title: string;
  description: string;
  jsonld?: object[];
  noindex?: boolean;
  crumbs?: { name: string; path: string }[]; // trail after Home; emits BreadcrumbList
}
const { title, description, jsonld = [], noindex = false, crumbs } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = (Astro.site ?? new URL("http://localhost")).origin;
const ogImage = `${siteUrl}/og.png`;
// Site-wide structured data from already-stated facts only. HVACBusiness (full facts) replaces Organization when a page passes it.
const hasBusiness = jsonld.some((j: any) => typeof j?.["@id"] === "string" && j["@id"].endsWith("#business"));
const isHome = Astro.url.pathname === "/";
const baseLd = [
  isHome ? buildWebSite(business, siteUrl) : null,
  isHome && !hasBusiness ? buildOrganization(business, siteUrl, counties.map((c) => `${c.name} County, ${business.state}`)) : null,
  crumbs ? buildBreadcrumbs(crumbs, siteUrl) : null,
].filter(Boolean) as object[];
// Escape "<" in JSON-LD so a value can never close the script tag. Built without a literal backslash on purpose.
const LT = String.fromCharCode(92) + "u003c";
const ldJson = [...baseLd, ...jsonld].map((j) => JSON.stringify(j).replace(/</g, LT));
const tel = business.phoneE164 ? `tel:${business.phoneE164}` : null;
const book = business.bookingUrl;
const path = Astro.url.pathname;
const leadsApi = import.meta.env.PUBLIC_LEADS_API; // set only when the lead API is deployed; otherwise no request form link renders
const hasActions = Boolean(tel || book || leadsApi);
const chatApi = import.meta.env.PUBLIC_CHAT_API; // set only when the chat API is deployed; otherwise no chat UI renders
const current = (href: string) => (path.startsWith(href) ? "page" : undefined);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={business.brandName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${business.brandName} logo`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {(isPlaceholderBuild || isFixtureBuild || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>document.documentElement.classList.add("js");</script>
    {ldJson.map((j) => <script type="application/ld+json" set:html={j} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="bar">
        <a class="brand" href="/" aria-current={path === "/" ? "page" : undefined}><img class="brand-logo" src="/brand/logo.svg" width="128" height="40" alt={business.brandName} /></a>
        <nav aria-label="Primary">
          <a href="/#services">Services</a>
          <a href="/#how">How it works</a>
          <a href="/service-area/" aria-current={current("/service-area/")}>Service area</a>
        </nav>
        {hasActions && (
          <div class="actions">
            {tel && <a class="btn" href={tel}><Icon name="phone" />{business.phoneDisplay}</a>}
            {leadsApi && <a class="btn" href="/request/" aria-current={current("/request/")}><Icon name="note-pencil" />Request service</a>}
            {book && <a class="btn" href={book} rel="noopener"><Icon name="calendar-check" />Book service</a>}
          </div>
        )}
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer band-ink">
      <div class="inner">
        <div>
          <p class="title-1">{business.brandName}</p>
          <p class="body-6 muted">Heating and cooling for homes and commercial buildings{business.serviceRegion ? ` in ${business.serviceRegion}` : ""}.</p>
          {business.streetAddress && <p class="body-6">{business.streetAddress}, {business.city}, {business.state} {business.postalCode}</p>}
          {business.hours && <p class="body-6">{business.hours}</p>}
        </div>
        <nav aria-label="Footer">
          <h2>Explore</h2>
          <ul class="body-5">
            <li><a href="/#services">Services</a></li>
            <li><a href="/#how">How it works</a></li>
            <li><a href="/service-area/">Service area</a></li>
            <li><a href="/privacy/">Privacy policy</a></li>
            <li><a href="/terms/">Terms</a></li>
          </ul>
        </nav>
        <div>
          <h2>Where we work</h2>
          <ul class="body-5">
            {counties.map((c) => <li><a href="/service-area/">{c.name} County</a></li>)}
          </ul>
        </div>
        <div class="fine caption-2">
          <p>Photos on this site are illustrative stock images. They are not our team or our completed work.</p>
          <p><a href="#main">Back to top</a></p>
        </div>
      </div>
    </footer>
    {chatApi && <ChatWidget api={chatApi} />}
    {/* Mobile click-to-call bar, mirrors the header actions */}
    {hasActions && path !== "/request/" && (
      <div class="sticky-bar" aria-label="Call, request or book">
        {tel && <a class="btn" href={tel}><Icon name="phone" />Call</a>}
        {leadsApi && <a class="btn" href="/request/"><Icon name="note-pencil" />Request</a>}
        {book && <a class="btn" href={book} rel="noopener"><Icon name="calendar-check" />Book</a>}
      </div>
    )}
  <script is:inline>
    (function () {
      var d = document.documentElement;
      var onScroll = function () { d.classList.toggle("is-scrolled", window.scrollY > 8); };
      window.addEventListener("scroll", onScroll, { passive: true }); onScroll();
      var items = document.querySelectorAll("[data-reveal], .tag-word");
      if (!("IntersectionObserver" in window)) { items.forEach(function (n) { n.classList.add(n.classList.contains("tag-word") ? "on" : "in"); }); return; }
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add(e.target.classList.contains("tag-word") ? "on" : "in");
          io.unobserve(e.target);
        });
      }, { rootMargin: "0px 0px -15% 0px", threshold: 0.05 });
      items.forEach(function (n) { io.observe(n); });
    })();
  </script>
  </body>
</html>
