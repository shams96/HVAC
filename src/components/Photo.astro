---
// Responsive stock photo (WebP at 800 and 1600 px). Width and height are always set so layout cannot shift.
// These are stock images: alt text stays generic and never claims the people or places are ours (see public/img/LICENSES.md).
interface Props { id: string; w: number; h: number; alt: string; sizes?: string; eager?: boolean; position?: string; class?: string }
const { id, w, h, alt, sizes = "(min-width: 64rem) 50vw, 100vw", eager = false, position = "center", class: cls = "" } = Astro.props;
const base = `/img/pexels-${id}`;
---
<img
  class={`photo ${cls}`}
  src={`${base}-1600.webp`}
  srcset={`${base}-800.webp 800w, ${base}-1600.webp 1600w`}
  sizes={sizes}
  width={w} height={h} alt={alt}
  loading={eager ? "eager" : "lazy"} decoding={eager ? "sync" : "async"} fetchpriority={eager ? "high" : "auto"}
  style={`object-position: ${position}`}
/>

<style>
  .photo { display: block; inline-size: var(--layout-full); block-size: var(--layout-full); object-fit: cover; }
</style>
