---
// The page's single primary action: check coverage by ZIP. Instant answer with JavaScript; without it the form
// submits to the service area page (GET), which lists every ZIP code we cover.
import Icon from "./Icon.astro";
import { counties, totalZips } from "../data/dfw-coverage";
import { business } from "../data/business";
interface Props { idSuffix: string; dark?: boolean }
const { idSuffix, dark = false } = Astro.props;
const id = `zip-${idSuffix}`;
const countyNames = counties.map((c) => c.name).join(", ");
const requestOpen = Boolean(import.meta.env.PUBLIC_LEADS_API); // the request form exists only once the lead API is deployed
const bookUrl = business.bookingUrl ?? "";
---
<form class:list={["coverage", { dark }]} action="/service-area/" method="get" novalidate data-request={requestOpen ? "1" : ""} data-book={bookUrl}>
  <label class="body-1" for={id}>Your ZIP code</label>
  <div class="row">
    <input
      id={id} name="zip" inputmode="numeric" autocomplete="postal-code" required
      pattern="[0-9]{5}" maxlength="5" aria-describedby={`${id}-help ${id}-result`}
      title="Enter a 5 digit ZIP code" placeholder="75201"
    />
    <button type="submit" class="btn btn-lg">Check coverage<Icon name="arrow-right" /></button>
  </div>
  <p id={`${id}-help`} class="caption-2 help">We list {totalZips} ZIP codes in {countyNames} counties.</p>
  <p id={`${id}-result`} class="result body-2" role="status" aria-live="polite" hidden></p>
</form>

<style>
  .coverage { display: grid; gap: var(--space-75); max-width: 30rem; }
  .row { display: flex; flex-wrap: wrap; gap: var(--space-75); }
  input {
    min-height: var(--touch-min); padding: var(--space-75) var(--space-200); inline-size: 9.5rem;
    font: var(--weight-semibold) var(--text-lg) / var(--lh-lg) var(--font-body); letter-spacing: 0.05em; color: var(--color-ink);
    background: var(--color-surface-raised); border: var(--border-strong) solid var(--color-ink-muted); border-radius: var(--radius-lg);
    transition: border-color var(--dur-color) var(--ease);
  }
  input::placeholder { color: var(--color-ink-muted); opacity: 1; letter-spacing: 0.05em; }
  input:focus-visible { border-color: var(--color-focus); }
  input:user-invalid { border-color: var(--color-accent); }
  .help { margin: 0; color: var(--color-ink-muted); }
  .result { margin: 0; padding: var(--space-100) var(--space-200); border-radius: var(--radius-lg); border: var(--border-thin) solid var(--color-rule); background: var(--color-surface-raised); color: var(--color-ink); }
  .result[hidden] { display: none; }
  .result :global(.next) { display: flex; flex-wrap: wrap; gap: var(--space-75); margin-top: var(--space-100); }
  .result.ok { border-color: var(--color-primary); border-width: var(--border-strong); }
  .result.miss { border-color: var(--color-accent); border-width: var(--border-strong); }
  .coverage.dark .help { color: var(--color-on-dark-muted); }
  .coverage.dark label { color: var(--color-on-dark); }
  .coverage.dark .btn { box-shadow: 0 0 0 var(--border-strong) var(--color-on-dark); }
</style>

<script>
  import zips from "../data/dfw-zips.json";
  const county = new Map<string, string>(zips.map((z) => [z.zip, z.county]));

  function answer(form: HTMLFormElement, raw: string) {
    const out = form.querySelector<HTMLElement>(".result");
    if (!out) return;
    const z = raw.trim();
    out.classList.remove("ok", "miss");
    if (!/^\d{5}$/.test(z)) { out.className = "result body-2 miss"; out.textContent = "Enter a 5 digit ZIP code, for example 75201."; out.hidden = false; return; }
    const c = county.get(z);
    out.className = `result body-2 ${c ? "ok" : "miss"}`;
    const wantRequest = form.dataset.request === "1", book = form.dataset.book ?? "";
    out.textContent = c
      ? `Yes, we serve ${z} in ${c} County.${wantRequest || book ? " Choose how to continue:" : ""}`
      : `${z} is not on our list. Contact us to confirm, because the edge of the area can move.`;
    if (c && (wantRequest || book)) {
      const row = document.createElement("div"); row.className = "next";
      const add = (href: string, text: string) => { const a = document.createElement("a"); a.className = "btn"; a.href = href; a.textContent = text; row.append(a); };
      if (wantRequest) add(`/request/?zip=${z}`, "Request service");
      if (book) add(book, "Book a time");
      out.append(row);
    }
    out.hidden = false;
  }

  document.querySelectorAll<HTMLFormElement>("form.coverage").forEach((form) => {
    const input = form.querySelector<HTMLInputElement>("input")!;
    form.addEventListener("submit", (e) => { e.preventDefault(); answer(form, input.value); });
    // Arrived from another page's form (no JavaScript there) or a shared link: answer straight away.
    if (location.pathname.startsWith("/service-area") && form.dataset.prefill !== "off") {
      const z = new URLSearchParams(location.search).get("zip");
      if (z) { input.value = z; answer(form, z); }
    }
  });
</script>
