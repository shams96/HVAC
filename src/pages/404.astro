---
import Base from "../layouts/Base.astro";
import CoverageForm from "../components/CoverageForm.astro";
---
<Base title="Page not found" description="That page does not exist. Check whether we serve your ZIP code or go back to the home page." noindex>
  <section class="wrap stack">
    <h1 class="heading-2">We could not find that page</h1>
    <p class="body-3">The address may be mistyped or the page may have moved. You can check coverage for your ZIP code below or <a href="/">go back to the home page</a>.</p>
    <CoverageForm idSuffix="404" />
  </section>
</Base>
