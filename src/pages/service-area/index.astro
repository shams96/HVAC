---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import CoverageForm from "../../components/CoverageForm.astro";
import ServiceAreaBands from "../../components/ServiceAreaBands.astro";
import { activeAreas } from "../../data/service-areas";
import { services } from "../../data/services";
import { counties, totalZips } from "../../data/dfw-coverage";
import { business, isPlaceholderBuild, isFixtureBuild } from "../../data/business";

const nameOf = (slug: string) => services.find((s) => s.slug === slug)?.name ?? slug;
const showPending = isPlaceholderBuild || isFixtureBuild;
const region = business.serviceRegion ?? "the Dallas and Fort Worth area";
---
<Base title={`Service area: ${region}`} description={`The cities, counties and ${totalZips} ZIP codes we list in ${region}. Check your ZIP code for an instant answer.`}>
  <section class="wrap">
    <div class="intro stack">
      <p class="eyebrow"><Icon name="map-trifold" /> Service area</p>
      <h1 class="heading-2">We serve {region}</h1>
      <p class="body-3 lede">Four counties: {counties.map((c) => c.name).join(", ")}. Enter your ZIP code for an instant answer, or find it in the lists below.</p>
      <CoverageForm idSuffix="area" />
    </div>

    <div class="counties">
      {counties.map((c) => (
        <section class="card county" aria-labelledby={`c-${c.name}`}>
          <h2 id={`c-${c.name}`} class="heading-5">{c.name} County</h2>
          <p class="body-6 cities">{c.cities.join(", ")}.</p>
          <details>
            <summary class="body-1">All {c.zips.length} ZIP codes</summary>
            <ul class="zips">{c.zips.map((z) => <li class="chip">{z}</li>)}</ul>
          </details>
        </section>
      ))}
    </div>
    <p class="body-6 fine">City names are for orientation and are not a promise of service to every street. ZIP codes are US Census ZIP code tabulation areas with at least half their land in these counties, so a few postal ZIP codes at the edge may differ. Contact us to confirm an address near the border.</p>
    {showPending && <p class="pending">Coverage follows the stated area. Edge ZIP codes need the owner's confirmation.</p>}

    {activeAreas.length > 0 && (
      <>
        <h2 class="heading-4 sub">ZIP codes with local detail pages</h2>
        <table>
          <caption class="sr">ZIP codes with a local detail page</caption>
          <thead><tr><th scope="col">ZIP</th><th scope="col">City</th><th scope="col">Travel time</th><th scope="col">Services</th></tr></thead>
          <tbody>
            {activeAreas.map((a) => (
              <tr>
                <th scope="row"><a href={`/service-area/${a.slug}/`} data-zip={a.zip}>{a.zip}</a></th>
                <td>{a.city}, {a.state}</td>
                <td>{a.travelBand} min</td>
                <td>{a.serviceLines.map(nameOf).join(", ")}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <h2 class="heading-4 sub">Coverage by travel time</h2>
        <ServiceAreaBands areas={activeAreas} />
      </>
    )}
  </section>
</Base>

<style>
  .sr { position: absolute; left: -999rem; }
  .intro { max-width: 40rem; margin-bottom: var(--space-600); }
  .lede { color: var(--color-ink-muted); }
  .counties { display: grid; gap: var(--space-300); }
  .county { padding: var(--space-400); display: grid; gap: var(--space-100); align-content: start; }
  .county p { margin: 0; }
  .cities { color: var(--color-ink-muted); }
  summary { cursor: pointer; padding: var(--space-75) 0; color: var(--color-primary); }
  .zips { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-75); padding-top: var(--space-100); }
  .fine { margin-top: var(--space-400); color: var(--color-ink-muted); }
  .sub { margin-top: var(--space-600); }
  table { width: var(--layout-full); border-collapse: collapse; margin: var(--space-300) 0 var(--space-500); }
  th, td { text-align: left; padding: var(--space-75) var(--space-200); border-bottom: var(--border-thin) solid var(--color-rule); }
  thead th { border-bottom: var(--border-strong) solid var(--color-primary); }
  @media (min-width: 48rem) { .counties { grid-template-columns: repeat(2, 1fr); } }
</style>
